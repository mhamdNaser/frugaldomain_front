# Prerendered pages live in folders (Faq/index.html). By default Apache answers
# "/Faq" with a 301 to "/Faq/", while each page's canonical and the sitemap use
# "/Faq" - so search engines saw every page as a redirect. Serve the folder's
# index.html at the slash-less URL instead.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # "/Faq/" -> "/Faq": one canonical address per prerendered page.
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # The build runs on Windows, where "about-us/..." and "About-Us" are the same
  # folder, so the profile snapshot lands under About-Us/. Linux is case
  # sensitive, so map the lowercase route onto it explicitly.
  RewriteCond %{DOCUMENT_ROOT}/about-us/muhammed-nasser-edden/index.html !-f
  RewriteCond %{DOCUMENT_ROOT}/About-Us/muhammed-nasser-edden/index.html -f
  RewriteRule ^about-us/muhammed-nasser-edden/?$ About-Us/muhammed-nasser-edden/index.html [L]

  # "/Faq" -> Faq/index.html, served in place (no redirect).
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]

  # Let real files pass through.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # SPA fallback.
  RewriteRule . /index.html [L]
</IfModule>

# Vite fingerprints every file in /assets, so those URLs can be cached
# indefinitely. HTML must never be cached or visitors keep booting an old
# bundle after a deploy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|png|jpe?g|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Text assets are served compressed; this is what "enable text compression"
# in PageSpeed asks for.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
